generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url = env("DATABASE_URL")
}


// after making a change here, run this: npx prisma migrate dev --name description_description

model User {
  username String @id @db.VarChar(50)
  password String @db.VarChar(255)
  firstName String @db.VarChar(50)
  lastName String @db.VarChar(50)
  email String @unique(map: "email") @db.VarChar(255)
  phone String @unique(map: "phone") @db.VarChar(15)

  blogs    Blog[]     @relation("UserBlogs")
  comments Comment[]  @relation("UserComments")
}

model Blog {
  id          Int      @id @default(autoincrement())
  subject     String
  description String
  tags        String
  createdAt   DateTime @default(now())
  author User @relation("UserBlogs", fields: [authorUsername], references: [username], onDelete: Cascade)
  authorUsername String

  comments    Comment[]
}

model Comment {
  id        Int      @id @default(autoincrement())
  sentiment String
  content   String
  createdAt DateTime @default(now())
  blog      Blog     @relation(fields: [blogId], references: [id], onDelete: Cascade)
  blogId    Int
  author User @relation("UserComments", fields: [authorUsername], references: [username], onDelete: Cascade)
  authorUsername String 
}
